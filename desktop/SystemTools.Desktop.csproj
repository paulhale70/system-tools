<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SystemTools.Desktop</RootNamespace>
    <AssemblyName>SystemTools.Desktop</AssemblyName>
    <Version>1.4.1</Version>
    <Authors>Paul Hale</Authors>
    <Product>System-tools Diagnostics</Product>
    <ApplicationIcon></ApplicationIcon>
    <!-- Self-contained single-file publish defaults; override at publish time. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <!-- Everything the app needs is compiled in, so the published .exe stands
       alone. Read at runtime by Services/BundledAssets.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\diagnostics\*.ps1" Exclude="..\diagnostics\install.ps1"
                      LogicalName="diagnostics/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\diagnostics\plugins\README.md;..\diagnostics\plugins\_sample.ps1.disabled"
                      LogicalName="diagnostics/plugins/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="..\web\vendor\*.js" LogicalName="web/vendor/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
