<UserControl x:Class="SystemTools.Desktop.Views.DumpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid DataContext="{Binding Dumps}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Analyze" Style="{StaticResource PrimaryButton}"
                        Click="OnAnalyzeClick" IsEnabled="{Binding CanAnalyze}"
                        ToolTip="Run the Windows debugger on the selected dump and explain the result." />
                <Button Content="Browse for a .dmp..." Margin="12,0,0,0" Padding="12,6"
                        Click="OnBrowseClick" IsEnabled="{Binding CanStart}" />
                <Button Content="Refresh list" Margin="8,0,0,0" Padding="12,6"
                        Click="OnRefreshClick" IsEnabled="{Binding CanStart}" />
                <Button Content="Cancel" Margin="8,0,0,0" Padding="12,6"
                        Click="OnCancelClick"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Not elevated: blue-screen dumps are hidden -->
        <Border Grid.Row="1" Background="#FEF3C7" Padding="20,8"
                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Padding="10,4"
                        Click="OnElevateClick" />
                <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12,16,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Crash dumps, last 90 days" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Dumps.Count, StringFormat=' ({0})'}"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Dumps}"
                             SelectedItem="{Binding SelectedDump}"
                             ItemContainerStyle="{StaticResource HistoryItem}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Written}" FontWeight="SemiBold" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="#EEF2FF" CornerRadius="999" Padding="8,1">
                                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" &#183; " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <wv2:WebView2 Source="{Binding ReportUri}"
                              Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding HasReport, Converter={StaticResource InvertedBoolToVis}}">
                    <TextBlock Text="Crash dump analysis" FontSize="16"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" Width="240" Margin="0,14,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
